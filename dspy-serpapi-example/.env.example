# Copy this file to .env and replace the placeholder with your SerpApi key.
SERPAPI_API_KEY=replace-with-your-serpapi-key

# Required only for --agent mode, for example: gemini/gemini-3.5-flash
# DSPY_MODEL=
GEMINI_API_KEY=replace-with-your-gemini-key

# Optional; these are the defaults used by the Makefile and main.py.
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT=dspy-serpapi-demo
